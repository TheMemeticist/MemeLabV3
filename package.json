{
  "name": "memelab-cda-v3",
  "version": "3.0.0-rc.1",
  "private": true,
  "type": "module",
  "description": "MemeLab — Cellular Defense Automata V3. Simulate outbreaks. Evolve strains. Master defenses.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "vite-node tests/bench.ts",
    "bench:node": "node tests/bench/run-node.mjs ts",
    "bench:backends": "node tests/bench/run-node.mjs backends",
    "bench:fit": "node tests/bench/run-node.mjs fit",
    "bench:frame": "node tests/bench/run-node.mjs frame",
    "bench:browser": "node tests/bench/run-browser.mjs",
    "bench:ladder": "node tests/bench/ladder.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
